 	snmp_info_default("output.L2.power.percent", 0, 1.0, IETF_OID_UPS_MIB "4.4.1.5.2", "", SU_OUTPUT_3, NULL),
@@ -201,14 +215,17 @@ static snmp_info_t ietf_mib[] = {
