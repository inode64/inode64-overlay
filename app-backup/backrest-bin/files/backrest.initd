#!/sbin/openrc-run
# Copyright 1999-2026 Gentoo Authors
# Distributed under the terms of the GNU General Public License v2

name="backrest"
description="backrest Daemon"

# See /etc/conf.d/backrest.
: "${BACKREST_BIND_HOST:=127.0.0.1}"
: "${BACKREST_BIND_PORT:=9898}"
: "${BACKREST_BIND_INTERFACE:=}"
: "${BACKREST_BIND_FAMILY:=4}"
: "${BACKREST_BIND_TIMEOUT:=30}"
: "${BACKREST_RESTIC_CACHE_DIR:=}"

backrest_data_dir="/var/lib/backrest"

command="/usr/bin/backrest"
command_background=true
pidfile="/run/backrest.pid"
supervisor=supervise-daemon

output_log="/var/log/backrest/backrest.log"
error_log="/var/log/backrest/backrest.log"

depend() {
	need net localmount
	# Only orders the start when netifrc manages the interface; the address
	# itself is waited for in start_pre().
	if [ -n "${BACKREST_BIND_INTERFACE}" ]; then
		after "net.${BACKREST_BIND_INTERFACE}"
	fi
}

# First usable global address of family BACKREST_BIND_FAMILY on interface $1.
_interface_address() {
	ip -o "-${BACKREST_BIND_FAMILY}" addr show dev "$1" scope global 2>/dev/null |
		awk '!/ (tentative|deprecated|dadfailed|temporary) / { sub("/.*", "", $4); print $4; exit }'
}

# Mount points of /etc/fstab that hold the path $1, itself or one of its
# parents, leaving out the root filesystem.
_fstab_mounts_for() {
	awk -v path="$1" '
		$1 !~ /^#/ && $2 ~ /^\/./ {
			mnt = $2
			sub("/+$", "", mnt)
			if (path == mnt || index(path, mnt "/") == 1)
				print mnt
		}' /etc/fstab
}

# The data directory and the restic cache may live on volumes of their own.
# If one listed in /etc/fstab is missing, backrest would start over with an
# empty config and restic would fill the root filesystem underneath it.
_check_mounts() {
	local dir mnt
	for dir in "$@"; do
		[ -n "${dir}" ] || continue
		dir="$(readlink -f "${dir}" 2>/dev/null || printf '%s' "${dir%/}")"
		for mnt in $(_fstab_mounts_for "${dir}"); do
			if ! mountpoint -q "${mnt}"; then
				eerror "${mnt} is in /etc/fstab but not mounted (needed for ${dir})"
				return 1
			fi
		done
	done
}

start_pre() {
	local host="${BACKREST_BIND_HOST}"
	local cache_dir="${BACKREST_RESTIC_CACHE_DIR}"

	# restic's own default, which is what it uses when the variable is empty.
	if [ -z "${cache_dir}" ] && [ -n "${HOME}" ]; then
		cache_dir="${XDG_CACHE_HOME:-${HOME}/.cache}/restic"
	fi
	_check_mounts "${backrest_data_dir}" "${cache_dir}" || return 1

	if [ -n "${BACKREST_BIND_INTERFACE}" ]; then
		case "${BACKREST_BIND_FAMILY}" in
			4|6) ;;
			*)
				eerror "BACKREST_BIND_FAMILY must be 4 or 6, not '${BACKREST_BIND_FAMILY}'"
				return 1
				;;
		esac
		if ! command -v ip >/dev/null 2>&1; then
			eerror "ip(8) is needed to find the address of ${BACKREST_BIND_INTERFACE}"
			return 1
		fi

		local timeout="${BACKREST_BIND_TIMEOUT}"
		host="$(_interface_address "${BACKREST_BIND_INTERFACE}")"
		while [ -z "${host}" ] && [ "${timeout}" -gt 0 ]; do
			sleep 1
			timeout=$((timeout - 1))
			host="$(_interface_address "${BACKREST_BIND_INTERFACE}")"
		done
		if [ -z "${host}" ]; then
			eerror "No IPv${BACKREST_BIND_FAMILY} address on ${BACKREST_BIND_INTERFACE}"
			return 1
		fi
		einfo "Listening on ${BACKREST_BIND_INTERFACE} (${host})"
	fi

	# An IPv6 literal needs brackets in front of the port.
	case "${host}" in
		\[*\]) ;;
		*:*) host="[${host}]" ;;
	esac

	if [ -n "${BACKREST_RESTIC_CACHE_DIR}" ]; then
		checkpath -d -m 0700 "${BACKREST_RESTIC_CACHE_DIR}" || return 1
		export RESTIC_CACHE_DIR="${BACKREST_RESTIC_CACHE_DIR}"
	fi

	command_args="-restic-cmd /usr/bin/restic -data-dir ${backrest_data_dir}/ -config-file ${backrest_data_dir}/config.json -bind-address ${host}:${BACKREST_BIND_PORT}"
}
