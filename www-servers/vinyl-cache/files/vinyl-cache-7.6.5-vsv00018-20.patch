Fixes for VSV00018 (CVE-2026-34475), VSV00019 (CVE-2026-50052) and VSV00020
(CVE-2026-93894), which upstream only released for >=8.0.1, >=8.0.2 and >=9.0.2.

Taken from Debian varnish 7.7.0-3+deb13u2 (debian/patches/fix_vsv18_{1..5},
fix_vsv19, fix_vsv20), which backports the Vinyl Cache commits 73dcb85eb8ad,
5c016b070e19, f89df57ab8e3, e8eccd46514e, 613b6f6a3b5e and 853d397f3075.
The Tstreq() macro uses plain memcmp() because 7.6 has no vmemcmp() helper.

Behaviour change from VSV00018: the built-in VCL answers 400 to a req.url that
does not start with "/" and feature +https_scheme is now on by default.

--- va/bin/varnishd/builtin.vcl
+++ vb/bin/varnishd/builtin.vcl
@@ -41,6 +41,7 @@
 }
 
 sub vcl_builtin_recv {
+	call vcl_req_url;
 	call vcl_req_host;
 	call vcl_req_method;
 	call vcl_req_authorization;
@@ -58,6 +59,16 @@
 		return (synth(400));
 	}
 }
+
+sub vcl_req_url {
+	if (req.url == "*" && req.method == "OPTIONS") {
+		return;
+	}
+	# CONNECT retains the stable vcl_req_method pipe policy.
+	if (req.url !~ "^/" && req.method != "CONNECT") {
+		return (synth(400));
+	}
+}
 
 sub vcl_req_method {
 	if (req.method == "PRI") {
