# /etc/conf.d/vinyld

VINYLD="/usr/sbin/vinyld"
VINYLRELOAD="/usr/sbin/vinylreload"

CONFIGFILE="/etc/vinyl-cache/default.vcl"

# Listen on localhost:8080; the backends are defined in CONFIGFILE
VINYLD_OPTS="-a localhost:8080"

# Listen on all interfaces
#VINYLD_OPTS="-a :8080"

# Options for vinylreload(1) on "reload", e.g. keep only the 5 most recent
# reloaded VCLs instead of all of them:
#VINYLRELOAD_OPTS="-m 5"

# A stop waits for the worker to finish the requests in flight, up to
# cli_timeout (60 s by default).  If you raise cli_timeout with -p, keep
# the TERM wait above it:
#retry="TERM/90/KILL/10"

# You may need to increase the number of open files (-n)
# and the maximum amount off locked memory (-l)
# See bug #459142
#rc_ulimit="-n 32786 -l 82000"
