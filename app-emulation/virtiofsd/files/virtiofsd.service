[Unit]
Description=VirtioFS daemon for %i
Requires=virtiofsd@%i.socket
After=virtiofsd@%i.socket
After=local-fs.target
Before=libvirtd.service virtqemud.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
# Los valores por defecto se pueden sobrescribir en el fichero de instancia.
# EXTRA_ARGS acepta opciones adicionales, por ejemplo: --xattr --posix-acl.
Environment=INODE_HANDLES=prefer CACHE=auto SANDBOX=namespace EXTRA_ARGS=--xattr
EnvironmentFile=/etc/virtiofsd/%i.conf

# systemd pasa el socket de escucha como descriptor 3.
ExecStart=/usr/libexec/virtiofsd \
  --fd=3 \
  --shared-dir=${SHARED_DIR} \
  --inode-file-handles=${INODE_HANDLES} \
  --announce-submounts \
  --cache=${CACHE} \
  --sandbox=${SANDBOX} \
  $EXTRA_ARGS

# Reinicio tras errores
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
