Build against upstream LLVM 23 (no ROCm llvm-project fork):
- replicate the GPUKind-based SGPR helpers that only exist in the fork
- drop the gfx1250-strict ISA entry (EF_AMDGPU_MACH_AMDGCN_GFX1250_STRICT is fork-only)

--- a/src/comgr-metadata.cpp	2026-09-08 01:34:04.000000000 +0200
+++ b/src/comgr-metadata.cpp	2026-10-07 11:00:32.991697110 +0200
@@ -36,6 +36,40 @@
 using namespace llvm;
 using namespace llvm::object;
 
+namespace {
+// Upstream LLVM does not provide the GPUKind-based SGPR helpers that the
+// ROCm llvm-project fork adds to AMDGPUTargetParser.h.  Replicate them here
+// (same logic as llvm/lib/TargetParser/AMDGPUTargetParser.cpp in the fork).
+unsigned compatGetTotalNumSGPRs(AMDGPU::GPUKind AK) {
+  AMDGPU::IsaVersion Version = AMDGPU::getIsaVersion(AMDGPU::getSubArch(AK));
+  if (Version.Major >= 8)
+    return 800;
+  return 512;
+}
+
+unsigned compatGetAddressableNumSGPRs(AMDGPU::GPUKind AK) {
+  // FeatureSGPRInitBug (gfx802 / tonga / iceland) fixes the SGPR count.
+  if (AK == AMDGPU::GK_GFX802)
+    return 96;
+
+  AMDGPU::IsaVersion Version = AMDGPU::getIsaVersion(AMDGPU::getSubArch(AK));
+  if (Version.Major >= 10)
+    return 106;
+  if (Version.Major >= 8)
+    return 102;
+  return 104;
+}
+
+unsigned compatGetSGPRAllocGranule(AMDGPU::GPUKind AK) {
+  AMDGPU::IsaVersion Version = AMDGPU::getIsaVersion(AMDGPU::getSubArch(AK));
+  if (Version.Major >= 10)
+    return compatGetAddressableNumSGPRs(AK);
+  if (Version.Major >= 8)
+    return 16;
+  return 8;
+}
+} // namespace
+
 namespace COMGR {
 namespace metadata {
 
