 using namespace llvm;
 using namespace llvm::object;
 
+#if LLVM_VERSION_MAJOR < 24
+// The TargetParser queries used below were added in LLVM 24. With an older
+// LLVM, answer them from the per-ISA table that Comgr used until ROCm 10.1.
+namespace llvm::AMDGPU {
+namespace {
+struct LegacyIsaInfo {
+  StringRef Processor;
+  bool ImageSupport;
+  unsigned LDSSize;
+  unsigned LDSBankCount;
+  unsigned EUsPerCU;
+  unsigned MaxWavesPerCU;
+  unsigned VGPRAllocGranule;
+  unsigned TotalNumVGPRs;
+  unsigned AddressableNumVGPRs;
+};
+
+// ELF_MACHINE is not expanded, so machs unknown to this LLVM do not matter.
+const LegacyIsaInfo LegacyIsaInfos[] = {
+#define HANDLE_ISA(TARGET_TRIPLE, PROCESSOR, ELF_MACHINE,                      \
+                   TRAP_HANDLER_ENABLED, IMAGE_SUPPORT, LDS_SIZE,              \
+                   LDS_BANK_COUNT, EUS_PER_CU, MAX_WAVES_PER_CU,               \
+                   MAX_FLAT_WORK_GROUP_SIZE, VGPR_ALLOC_GRANULE,               \
+                   TOTAL_NUM_VGPRS, ADDRESSABLE_NUM_VGPRS)                     \
+  {PROCESSOR,          IMAGE_SUPPORT,      LDS_SIZE,                           \
+   LDS_BANK_COUNT,     EUS_PER_CU,         MAX_WAVES_PER_CU,                   \
+   VGPR_ALLOC_GRANULE, TOTAL_NUM_VGPRS,    ADDRESSABLE_NUM_VGPRS},
+#include "comgr-isa-metadata.def"
+};
+
+const LegacyIsaInfo *findLegacyIsaInfo(GPUKind AK) {
+  StringRef Name = getArchNameAMDGCN(AK);
+  for (const LegacyIsaInfo &Info : LegacyIsaInfos)
+    if (Info.Processor == Name)
+      return &Info;
+  return nullptr;
+}
+
+// getIsaInfos() only enumerates processors that are in the table.
+const LegacyIsaInfo &getLegacyIsaInfo(GPUKind AK) {
+  const LegacyIsaInfo *Info = findLegacyIsaInfo(AK);
+  assert(Info && "processor missing from comgr-isa-metadata.def");
+  return *Info;
+}
+
+enum AMDGPUFeature : unsigned {
+  FEAT_XNACK_ON_OFF_MODES,
+  FEAT_SRAMECC_SUPPORT,
+  FEAT_IMAGE_INSTS,
+  FEAT_GFX10_INSTS,
+};
+
+class AMDGPUFeatureBitset {
+  unsigned Bits = 0;
+
+public:
+  void set(AMDGPUFeature F) { Bits |= 1u << F; }
+  bool test(AMDGPUFeature F) const { return Bits & (1u << F); }
+};
+
+unsigned getMajorVersion(GPUKind AK) {
+  return getIsaVersion(getSubArch(AK)).Major;
+}
+
+AMDGPUFeatureBitset getFeatureBitset(GPUKind AK) {
+  AMDGPUFeatureBitset Features;
+  unsigned ArchAttr = getArchAttrAMDGCN(AK);
+  if (ArchAttr & FEATURE_XNACK_ON_OFF_MODES)
+    Features.set(FEAT_XNACK_ON_OFF_MODES);
+  if (ArchAttr & FEATURE_SRAMECC)
+    Features.set(FEAT_SRAMECC_SUPPORT);
+  if (getLegacyIsaInfo(AK).ImageSupport)
+    Features.set(FEAT_IMAGE_INSTS);
+  if (getMajorVersion(AK) >= 10)
+    Features.set(FEAT_GFX10_INSTS);
+  return Features;
+}
+
+unsigned getLocalMemorySize(GPUKind AK, bool /*FullSIMDMode*/) {
+  return getLegacyIsaInfo(AK).LDSSize;
+}
+
+// The caller multiplies by its own EUsPerCU, so divide by the same value to
+// report the table's MaxWavesPerCU.
+unsigned getMaxWavesPerEU(GPUKind AK) {
+  unsigned EUsPerCU = getMajorVersion(AK) >= 10 ? 2 : 4;
+  return getLegacyIsaInfo(AK).MaxWavesPerCU / EUsPerCU;
+}
+
+constexpr unsigned getMaxFlatWorkGroupSize() { return 1024; }
+
+unsigned getVGPRAllocGranule(GPUKind AK, bool /*IsWave32*/) {
+  return getLegacyIsaInfo(AK).VGPRAllocGranule;
+}
+
+unsigned getTotalNumVGPRs(GPUKind AK, bool /*IsWave32*/) {
+  return getLegacyIsaInfo(AK).TotalNumVGPRs;
+}
+
+unsigned getAddressableNumVGPRs(GPUKind AK, bool /*IsWave32*/) {
+  return getLegacyIsaInfo(AK).AddressableNumVGPRs;
+}
+
+unsigned getLDSBankCount(GPUKind AK) {
+  return getLegacyIsaInfo(AK).LDSBankCount;
+}
+
+unsigned getTotalNumSGPRs(GPUKind AK) {
+  return getMajorVersion(AK) >= 8 ? 800 : 512;
+}
+
+unsigned getAddressableNumSGPRs(GPUKind AK) {
+  // SGPR init bug
+  if (AK == GK_GFX802 || AK == GK_GFX805)
+    return 96;
+  unsigned Major = getMajorVersion(AK);
+  return Major >= 10 ? 106 : Major >= 8 ? 102 : 104;
+}
+
+unsigned getSGPRAllocGranule(GPUKind AK) {
+  unsigned Major = getMajorVersion(AK);
+  return Major >= 10 ? getAddressableNumSGPRs(AK) : Major >= 8 ? 16 : 8;
+}
+} // namespace
+} // namespace llvm::AMDGPU
+#endif
+
