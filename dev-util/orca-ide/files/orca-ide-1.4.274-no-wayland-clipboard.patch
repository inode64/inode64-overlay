Ship the Wayland clipboard helper only with USE=wayland: electron-builder
fails on the missing extraResources file otherwise.

From the PF4Public overlay (dev-util/orca/files/strip-wayland-clipboard-r1.patch).

diff -ruN a/config/electron-builder.config.cjs b/config/electron-builder.config.cjs
--- a/config/electron-builder.config.cjs
+++ b/config/electron-builder.config.cjs
@@ -745,10 +745,6 @@
       ...commonExtraResources,
       ...createPackagedRuntimeNodeModuleResources('linux'),
       {
-        from: 'native/wayland-clipboard/.build/${arch}/orca-wayland-clipboard',
-        to: 'bin/orca-wayland-clipboard'
-      },
-      {
         from: 'native/provider-exec/.build/linux-${arch}/orca-provider-exec',
         to: 'bin/orca-provider-exec'
       },
