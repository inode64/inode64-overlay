Use tracefs directly and the new ras-mc-ctl DIMM subcommand.

Version 1.0 accepts the old tracing directory only as a fallback; its DIMM
label registration command moved under the dimm subcommand.

The DIMM service fix is from upstream commit:
https://github.com/mchehab/rasdaemon/commit/2bf14fcdf3dceaaa2d2e84cb8796b25ddd39c65f

--- a/misc/rasdaemon.service.in
+++ b/misc/rasdaemon.service.in
@@ -4,7 +4,7 @@
 Description=RAS daemon to log the RAS events
 # only needed when not running in foreground (--foreground | -f)
 #After=syslog.target
-RequiresMountsFor=/sys/kernel/debug
+RequiresMountsFor=/sys/kernel/tracing
 
 [Service]
 EnvironmentFile=@SYSCONFDEFDIR@/rasdaemon
--- a/misc/ras-mc-ctl.service.in
+++ b/misc/ras-mc-ctl.service.in
@@ -5,7 +5,7 @@
 
 [Service]
 Type=oneshot
-ExecStart=@sbindir@/ras-mc-ctl --register-labels
+ExecStart=@sbindir@/ras-mc-ctl dimm --register-labels
 RemainAfterExit=yes
 
 [Install]
