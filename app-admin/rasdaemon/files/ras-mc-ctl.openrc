description="Loads motherboard DIMM labels into the EDAC driver"

depend() {
	keyword -stop
	need sysfs
	after modules
}

start() {
	ebegin "Loading motherboard DIMM labels into the EDAC driver"
	/usr/sbin/ras-mc-ctl dimm --register-labels
	eend $?
}

stop() {
	:
}
