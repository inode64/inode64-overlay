 core/modules.h             |  6 +++--
 core/rasdaemon.c           | 21 ++++++----------
 db/db-core.c               | 51 ++++++++++++++++++++++++++++++++++++++
 db/db-core.h               | 20 +++++++++++++++
 db/ras-db.h                |  6 +++--
 docs/developer-guide.rst   | 13 ++++++----
 events-arch-x86/ras-erst.c |  1 +
 meson.build                |  2 +-
 tests/test-events.c        |  7 ++----
 tests/test-modules.c       | 43 ++++++++++++++++++++++++++++++--
 tests/test-sqlite3.c       | 14 ++++++++---
 12 files changed, 186 insertions(+), 42 deletions(-)
 create mode 100644 db/db-core.c
