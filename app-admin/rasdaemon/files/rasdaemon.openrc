#!/sbin/openrc-run
# Copyright 1999-2026 Gentoo Authors
# Distributed under the terms of the GNU General Public License v2

description="Logs Reliability, Availability and Serviceability events"

command="/usr/sbin/rasdaemon"
command_args="--foreground ${RASDAEMON_ARGS}"
command_background=true
pidfile="/run/${RC_SVCNAME}.pid"

depend() {
	need localmount sysfs
	after modules
	use logger
}

start_pre() {
	if ! mountinfo -q -f tracefs /sys/kernel/tracing; then
		checkpath --directory /sys/kernel/tracing || return 1
		mount -t tracefs tracefs /sys/kernel/tracing || return 1
	fi
}

start_post() {
	"${command}" --enable >/dev/null 2>&1
}

stop_post() {
	"${command}" --disable >/dev/null 2>&1
}
