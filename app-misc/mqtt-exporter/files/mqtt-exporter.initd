#!/sbin/openrc-run
# Copyright 2016-2026 Gentoo Authors
# Distributed under the terms of the GNU General Public License v2

description="Simple and generic Prometheus exporter for MQTT"
pidfile=/run/${RC_SVCNAME}.pid
command=/usr/bin/mqtt-exporter
command_user="mosquitto:mosquitto"
command_background="true"
error_log=/var/log/${RC_SVCNAME}/${RC_SVCNAME}_error.log
output_log=/var/log/${RC_SVCNAME}/${RC_SVCNAME}.log

# The exporter reads its settings from the environment, and conf.d is only sourced.
for var in $(sed -n 's/^\([A-Z0-9_]*\)=.*/\1/p' "/etc/conf.d/${RC_SVCNAME}" 2>/dev/null); do
	export "${var}"
done

depend() {
	after net mosquitto prometheus zigbee2mqtt
}

start_pre() {
	# The logs are opened after dropping privileges
	checkpath -d -m 0750 -o mosquitto:mosquitto "/var/log/${RC_SVCNAME}"
}
