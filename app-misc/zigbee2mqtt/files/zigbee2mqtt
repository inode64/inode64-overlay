#!/sbin/openrc-run

# On SIGTERM the bridge backs up the coordinator before it exits, reading its
# tables over the serial link: about 20 seconds with a hundred devices, longer
# on a larger network. A shorter wait reports a failed stop while the process
# is still on its way out. Override in /etc/conf.d/zigbee2mqtt.
: "${retry:=TERM/90/KILL/5}"

depend() {
	need mosquitto
}

checkconfig() {
	if [ ! -f /var/lib/${SVCNAME}/configuration.yaml ] ; then
		eerror "No /var/lib/${SVCNAME}/configuration.yaml file exists!"
	fi
}

start() {
	checkconfig || return 1
	ebegin "Starting ${SVCNAME}"
	start-stop-daemon --start --user zigbee2mqtt:zigbee2mqtt \
		--env ZIGBEE2MQTT_DATA=/var/lib/${SVCNAME} --exec /usr/bin/zigbee2mqtt \
		--background --make-pidfile --pidfile /run/${SVCNAME}.pid \
		--stdout /var/log/${SVCNAME}/stdout.log \
		--stderr /var/log/${SVCNAME}/stderr.log
	eend $?
}

stop() {
	ebegin "Stopping ${SVCNAME}"
	start-stop-daemon --stop --quiet --retry "${retry}" --pidfile /run/${SVCNAME}.pid
	eend $?
}
